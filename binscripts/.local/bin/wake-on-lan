#!/bin/bash

# WoL requires wake-on setting, each reboot resets this setting on remote deivce
# Config this script to boot on launch to ensure wake-on setting will always be enable

# Create list of all ethernet ports by searching for ports starting with e
# Searching for e may not be the most logical way
mapfile -t EthList < <(ls /sys/class/net | grep '^e')

# Current remote devices only have one port
# Parse list in case future device has more than one ethernet port
for Eth in "${EthList}"
	do 
	echo " turning $Eth wake-on g"
	sudo ethtool -s "$Eth" wol g
done	
