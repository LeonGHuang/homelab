#!/bin/bash

tmux new-window -d -n LARP

tmux split-window -h -t LARP.1
tmux split-window -v -t LARP.2

tmux send-keys -t LARP.1 "btop" Enter
tmux send-keys -t LARP.2 "cmatrix" Enter
tmux send-keys -t LARP.3 "fastfetch" Enter

tmux send-keys -t LARP.3 "tmux kill-window"

sleep 0.2
tmux select-window -t LARP
